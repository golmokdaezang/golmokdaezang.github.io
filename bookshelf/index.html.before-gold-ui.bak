<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1b140e">
  <title>선장의 서재 | 책장</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poor+Story&display=swap" rel="stylesheet">
  <style>
    :root { color-scheme: dark; font-family: Georgia, 'Noto Serif KR', serif; }
    * { box-sizing: border-box; }
    html,body { margin:0; width:100%; height:100%; overflow:hidden; background:#100e0b; }
    button { font:inherit; }
    .scene { position:fixed; inset:0; overflow:hidden; isolation:isolate; }
    .stage { position:absolute; width:1600px; height:960px; left:50%; top:50%; transform-origin:center; }
    .background { position:absolute; inset:0; width:100%; height:100%; object-fit:fill; pointer-events:none; user-select:none; }
    .background.night { opacity:0; transition:opacity .65s ease; }
    .scene.is-night .background.night { opacity:1; }
    .scene.is-night .background.day { opacity:0; }
    .background.day { opacity:1; transition:opacity .65s ease; }
    .book { position:absolute; border:0; background:transparent; padding:0; cursor:pointer; z-index:4; transform-origin:bottom center; transition:transform .28s ease,filter .28s ease; }
    .book img { display:block; width:100%; height:100%; object-fit:fill; filter:drop-shadow(2px 4px 4px rgba(0,0,0,.42)); pointer-events:none; }
    .book:hover { transform:translateY(-10px); filter:brightness(1.12); }
    .book.selected { transform:translateY(-26px) scale(1.035); filter:brightness(1.2) drop-shadow(0 0 12px rgba(255,205,107,.5)); z-index:6; }
    .lantern-hotspot { position:absolute; z-index:8; left:68%; top:11%; width:17%; height:29%; border:0; padding:0; background:transparent; cursor:pointer; }
    .lantern-hotspot:focus-visible, .book:focus-visible { outline:3px solid #f1d18b; outline-offset:4px; }
    .controls { position:absolute; left:50%; bottom:6%; z-index:12; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:10px; white-space:nowrap; }
    .selection-label { color:#f0dfb6; text-shadow:0 2px 9px #000; font-size:19px; letter-spacing:.08em; min-height:25px; }
    .open-button { border:1px solid rgba(248,216,145,.7); border-radius:6px; background:linear-gradient(180deg,#6a4725,#382317); box-shadow:0 4px 18px #0009, inset 0 1px #cda36d77; color:#f8e4b9; padding:14px 36px; font-size:22px; font-weight:bold; cursor:pointer; transition:filter .2s,transform .2s; }
    .open-button:hover:not(:disabled) { filter:brightness(1.2); transform:translateY(-2px); }
    .open-button:disabled { opacity:.65; cursor:default; }
    /* 종이가 둥근 원으로 잘리지 않고, 가장자리가 안개처럼 번져 나간다. */
    @property --mist-radius { syntax: '<length>'; inherits: false; initial-value: 0vmax; }
    .parchment-reveal {
      --mist-radius: 0vmax;
      position:fixed; inset:0; z-index:1000; pointer-events:none; visibility:hidden;
      background:#e8c99b url('/assets/images/parchment-bg.webp') center/cover no-repeat;
      -webkit-mask-image:radial-gradient(circle at 50% 50%,#000 0,#000 max(0px, calc(var(--mist-radius) - 19vmax)),transparent calc(var(--mist-radius) + 19vmax));
      mask-image:radial-gradient(circle at 50% 50%,#000 0,#000 max(0px, calc(var(--mist-radius) - 19vmax)),transparent calc(var(--mist-radius) + 19vmax));
      opacity:0;
    }
    .parchment-reveal.expanding {
      visibility:visible;
      animation:mist-expand 2.85s cubic-bezier(.42,0,.17,1) forwards;
    }
    .parchment-reveal.covered { visibility:visible; opacity:1; --mist-radius:180vmax; }
    @keyframes mist-expand {
      0% { --mist-radius:0vmax; opacity:0; filter:blur(3px); }
      12% { opacity:.9; }
      100% { --mist-radius:180vmax; opacity:1; filter:blur(0); }
    }
    /* 초록우산 어린이체 파일을 assets/fonts/green-umbrella.woff2 에 넣으면 적용된다. */
    @font-face {
      font-family:'Green Umbrella';
      src:url('/assets/fonts/green-umbrella.woff2') format('woff2');
      font-display:swap;
    }
    .writing-area {
      position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
      width:min(94vw,950px); height:230px; opacity:0; transition:opacity .18s ease;
      display:flex; align-items:center; justify-content:center;
    }
    .parchment-reveal.writing .writing-area { opacity:1; }
    .writing-text {
      position:relative; flex:none;
      white-space:nowrap; font-family:'Green Umbrella','초록우산 어린이체','Poor Story',cursive;
      font-weight:400; font-size:clamp(30px,5.6vw,70px); line-height:1.2;
      letter-spacing:.01em; color:#56351f; text-shadow:0 1px 1px #fff6;
    }
    .quill {
      position:absolute; left:0; top:0; width:clamp(90px,15vw,174px); height:auto;
      pointer-events:none; opacity:0; z-index:3;
      transform:translate(-10%,-95%) rotate(-6deg);
      filter:drop-shadow(5px 7px 4px #51351c50);
      transition:left .18s linear,top .18s ease-in-out,opacity .5s ease;
      transform-origin:12% 96%;
    }
    .parchment-reveal.writing .quill { opacity:1; }
    /* 펜촉이 종이를 톡톡 누르는 듯한 미세한 상하 떨림 */
    .quill.scribing { animation:quill-strokes .17s ease-in-out infinite alternate; }
    @keyframes quill-strokes {
      from { transform:translate(-10%,-95%) rotate(-8deg) translateY(0); }
      to { transform:translate(-10%,-95%) rotate(-3deg) translateY(4px); }
    }
    .quill.bob { animation:quill-idle 1.15s ease-in-out infinite; }
    @keyframes quill-idle {
      0%,100% {transform:translate(-10%,-95%) rotate(-6deg)}
      50% {transform:translate(-10%,-95%) rotate(-3deg) translate(3px,-4px)}
    }
    .parchment-reveal.departing .writing-area {
      opacity:0; transform:translate(-50%,-50%) scale(1.025);
      transition:opacity .8s ease,transform .8s ease;
    }
    .parchment-reveal.departing { filter:brightness(1.045); transition:filter .8s ease; }
    @media (prefers-reduced-motion:reduce) { .book,.background {transition:none;} .parchment-reveal.expanding {animation-duration:.01s;} .quill.bob,.quill.scribing {animation:none;} .quill {transition:none;} }
  </style>
</head>
<body>
  <main class="scene" id="scene" aria-label="선장의 서재 책장">
    <div class="stage" id="stage">
      <img class="background day" src="/assets/images/bookshelf-day.png" alt="" draggable="false">
      <img class="background night" src="/assets/images/bookshelf-night.png" alt="" draggable="false">
      <div id="books"></div>
      <button class="lantern-hotspot" id="lantern" type="button" aria-label="랜턴으로 낮과 밤 전환" aria-pressed="false"></button>
      <div class="controls">
        <div class="selection-label" id="selectionLabel" aria-live="polite">책을 선택해 주세요</div>
        <button class="open-button" id="openButton" type="button" disabled>책을 선택해 주세요</button>
      </div>
    </div>
  </main>
  <div class="parchment-reveal" id="parchmentReveal" aria-hidden="true">
    <div class="writing-area" id="writingArea">
      <div class="writing-text" id="writingText"></div>
      <img class="quill" id="quill" src="/assets/images/quill-white.webp" alt="">
    </div>
  </div>
  <script>
    'use strict';
    const bookData = [
      {name:'파란 책',file:'book-blue.png',x:29.8,y:18.7,w:3.3,h:20.9,color:'#173c65',symbol:'✧',url:'/'},
      {name:'초록 책',file:'book-green.png',x:33.0,y:18.3,w:3.3,h:21.3,color:'#244b39',symbol:'⚓',url:'/'},
      {name:'보라 책',file:'book-purple.png',x:36.2,y:19.3,w:3.3,h:20.3,color:'#49305e',symbol:'✺',url:'/'},
      {name:'갈색 책',file:'book-brown.png',x:39.4,y:18.1,w:3.3,h:21.5,color:'#704721',symbol:'◎',url:'/'},
      {name:'아쿠아 책',file:'book-aqua.png',x:42.6,y:19.1,w:3.3,h:20.5,color:'#17646b',symbol:'⚓',url:'/'},
      {name:'검정 책',file:'book-black.png',x:45.8,y:17.7,w:3.3,h:21.9,color:'#242323',symbol:'☠',url:'/'}
    ];
    const scene=document.getElementById('scene');
    const stage=document.getElementById('stage');
    const booksContainer=document.getElementById('books');
    const lantern=document.getElementById('lantern');
    const label=document.getElementById('selectionLabel');
    const openButton=document.getElementById('openButton');
    const parchment=document.getElementById('parchmentReveal');
    let selectedIndex=-1;
    let transitioning=false;

    function resizeStage() {
      const scale=Math.max(scene.clientWidth/1600,scene.clientHeight/960);
      stage.style.transform=`translate(-50%, -50%) scale(${scale})`;
    }
    window.addEventListener('resize',resizeStage,{passive:true});
    resizeStage();

    bookData.forEach((book,index)=>{
      const button=document.createElement('button');
      button.type='button';
      button.className='book';
      button.setAttribute('aria-label',`${book.name} 선택`);
      button.setAttribute('aria-pressed','false');
      button.style.left=book.x+'%';
      button.style.top=book.y+'%';
      button.style.width=book.w+'%';
      button.style.height=book.h+'%';
      const img=document.createElement('img');
      img.src='/assets/images/books/'+book.file;
      img.alt='';
      img.draggable=false;
      button.appendChild(img);
      button.addEventListener('click',()=>selectBook(index));
      booksContainer.appendChild(button);
    });

    function selectBook(index) {
      if(transitioning)return;
      selectedIndex=index;
      const book=bookData[index];
      booksContainer.querySelectorAll('.book').forEach((el,i)=>{
        const active=i===index;
        el.classList.toggle('selected',active);
        el.setAttribute('aria-pressed',String(active));
      });
      label.textContent=book.name;
      openButton.textContent=book.name+' 펼치기';
      openButton.disabled=false;
    }

    lantern.addEventListener('click',()=>{
      const isNight=scene.classList.toggle('is-night');
      lantern.setAttribute('aria-pressed',String(isNight));
    });

    const writingArea=document.getElementById('writingArea');
    const writingText=document.getElementById('writingText');
    const quill=document.getElementById('quill');
    const MESSAGE='기록을 불러오는 중...';
    const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));

    // 새 페이지 HTML을 미리 요청한다. 이는 실제 화면 렌더링 완료를 뜻하지 않는다.
    function warmDestination(url) {
      try {
        const target=new URL(url,location.href);
        if(target.origin!==location.origin) return Promise.resolve();
        return fetch(target.href,{credentials:'same-origin',cache:'default'})
          .then(()=>undefined).catch(()=>undefined);
      } catch(_) { return Promise.resolve(); }
    }

    function setPenAtTextEnd() {
      const area=writingArea.getBoundingClientRect();
      const text=writingText.getBoundingClientRect();
      // 펜촉이 마지막 글자 오른쪽 아래에 오도록 위치시킨다.
      quill.style.left=(text.right-area.left+3)+'px';
      quill.style.top=(text.bottom-area.top-7)+'px';
    }

    async function writeMessage() {
      writingText.textContent='';
      parchment.classList.add('writing');
      quill.classList.add('scribing');
      setPenAtTextEnd();
      for(const ch of Array.from(MESSAGE)) {
        writingText.textContent+=ch;
        setPenAtTextEnd();
        await wait(ch===' '?90:ch==='.'?135:155);
      }
      quill.classList.remove('scribing');
      quill.classList.add('bob');
    }

    async function openSelectedBook() {
      if(transitioning || selectedIndex<0) return;
      transitioning=true;
      openButton.disabled=true;
      lantern.disabled=true;
      const destination=bookData[selectedIndex].url||'/';
      let ready=false;
      const preload=warmDestination(destination).then(()=>{ready=true;});
      // 안개 같은 양피지가 약 2.85초 동안 번져 나온다.
      const expanded=new Promise(resolve=>{
        parchment.addEventListener('animationend',resolve,{once:true});
        setTimeout(resolve,3250);
      });
      parchment.classList.add('expanding');
      await expanded;
      parchment.classList.remove('expanding');
      parchment.classList.add('covered');
      // 로딩이 빨라도 펜이 문구를 끝까지 쓰도록 보장한다.
      await writeMessage();
      if(!ready) await Promise.race([preload,wait(2400)]);
      quill.classList.remove('bob');
      parchment.classList.add('departing');
      await wait(480);
      // 도착 페이지에 별도 오버레이를 설치하면 자연스럽게 이어진다.
      try {sessionStorage.setItem('parchmentArrival','1');} catch(_) {}
      window.location.assign(destination);
    }
    openButton.addEventListener('click',openSelectedBook);
  </script>
</body>
</html>
